<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descargar Minecraft"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Elegí el cargador o motor. Soportamos todas las versiones (1.7.10 a 26.3) y todos los loaders."
            android:textColor="#B8C4BC"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/vanilla_profile"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="Vanilla" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Versión oficial sin modificaciones (1.7 a 26.3)." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modded_profile_forge"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="Forge" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Instalador rápido silencioso para mods clásicos y modernos." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/modded_profile_fabric"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="Fabric" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Ligero, rápido y moderno." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modded_profile_neoforge"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="NeoForge" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Sucesor moderno de Forge para 1.20.1 y 1.21+." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/modded_profile_quilt"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="Quilt" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Compatible con ecosistema Fabric y mods Quilt." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/optifine_profile"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="OptiFine" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Optimización gráfica clásica y shaders." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pg_optimized_profile"
            style="@style/PgLoaderCard"
            android:layout_width="match_parent">

            <TextView
                style="@style/PgLoaderCardTitle"
                android:text="Optimized" />

            <TextView
                style="@style/PgLoaderCardSub"
                android:text="Instancia Paraguacraft lista para jugar con máximo rendimiento según tu celular." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pg_horizon_profile"
            style="@style/PgLoaderCard"
            android:layout_width="match_parent">

            <TextView
                style="@style/PgLoaderCardTitle"
                android:text="Horizon · Motor Nativo Rust (26.3)" />

            <TextView
                style="@style/PgLoaderCardSub"
                android:text="Motor experimental en Rust + Vulkan sin Java. Requiere cuenta oficial Microsoft." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modded_profile_modpack"
            style="@style/PgLoaderCard"
            android:layout_width="match_parent">

            <TextView
                style="@style/PgLoaderCardTitle"
                android:text="Modpack" />

            <TextView
                style="@style/PgLoaderCardSub"
                android:text="Creá una instancia vacía o importá un pack personalizado." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

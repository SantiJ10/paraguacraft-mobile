<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descargar Minecraft"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Elegí el cargador. Todas las versiones de Minecraft estables (sin snapshots ni betas)."
            android:textColor="#B8C4BC"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/vanilla_profile"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="Vanilla" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Versión oficial sin modificaciones." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modded_profile_forge"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="Forge" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Compatibilidad clásica con mods." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/modded_profile_fabric"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="Fabric" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Ligero, rápido y moderno." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/optifine_profile"
                style="@style/PgLoaderCard">

                <TextView
                    style="@style/PgLoaderCardTitle"
                    android:text="OptiFine" />

                <TextView
                    style="@style/PgLoaderCardSub"
                    android:text="Optimización gráfica y shaders." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pg_optimized_profile"
            style="@style/PgLoaderCard"
            android:layout_width="match_parent">

            <TextView
                style="@style/PgLoaderCardTitle"
                android:text="Optimized" />

            <TextView
                style="@style/PgLoaderCardSub"
                android:text="Instancia Paraguacraft para mejorar el rendimiento, con FPS según el celular." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modded_profile_modpack"
            style="@style/PgLoaderCard"
            android:layout_width="match_parent">

            <TextView
                style="@style/PgLoaderCardTitle"
                android:text="Modpack" />

            <TextView
                style="@style/PgLoaderCardSub"
                android:text="Creá una instancia vacía para instalar un pack." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

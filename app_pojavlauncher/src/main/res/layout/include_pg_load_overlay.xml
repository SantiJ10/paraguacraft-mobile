<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pg_load_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2000A08"
    android:gravity="center"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:translationZ="20dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_paraguacraft"
        android:contentDescription="@string/app_short_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Paraguacraft"
        android:textColor="#C4A574"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/pg_load_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="24dp"
        android:gravity="center"
        android:text="Abriendo Minecraft…"
        android:textColor="#EEEEEE"
        android:textSize="14sp" />
</LinearLayout>

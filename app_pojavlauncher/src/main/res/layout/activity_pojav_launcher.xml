<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/pg_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/pg_wall_river" />

    <View
        android:id="@+id/pg_wallpaper_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73051018" />

    <LinearLayout
        android:id="@+id/pg_launcher_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/pg_header_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/pg_logo" />

        <TextView
            android:id="@+id/pg_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Paraguacraft"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/pg_hub_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/pg_hub_library"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/pg_hub_button"
                android:contentDescription="Espacio"
                android:padding="10dp"
                android:src="@drawable/ic_menu_store" />

            <ImageButton
                android:id="@+id/pg_hub_controls"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/pg_hub_button"
                android:contentDescription="Controles"
                android:padding="10dp"
                android:src="@drawable/ic_menu_custom_controls" />

            <ImageButton
                android:id="@+id/pg_hub_skins"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/pg_hub_button"
                android:contentDescription="Skins"
                android:padding="10dp"
                android:src="@drawable/ic_menu_skins" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="168dp"
            android:layout_height="48dp"
            android:dropDownWidth="@dimen/_250sdp"
            android:dropDownVerticalOffset="48dp" />

        <ImageButton
            android:id="@+id/pg_cafecito"
            android:layout_width="92dp"
            android:layout_height="28dp"
            android:layout_marginEnd="2dp"
            android:adjustViewBounds="true"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Invitame un café"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/pg_cafecito" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_settings" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@+id/pg_launcher_header" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
